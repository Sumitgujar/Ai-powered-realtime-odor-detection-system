# Firebase Admin configuration
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com
# Absolute path or path relative to backend/.env. Never commit the JSON file.
FIREBASE_CREDENTIALS_PATH=
FIREBASE_SENSOR_DATA_PATH=sensor_readings
FIREBASE_PREDICTIONS_PATH=predictions
FIREBASE_ALERTS_PATH=alerts

# Trained ML artifact; relative paths resolve from backend/
ML_MODEL_PATH=../ml/models/odor_pipeline.joblib

# Comma-separated React origins; do not use * with credentials
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
